# ==========================================
# SkillArena AI — Environment Configuration Template
# (Do NOT commit real secret keys to this file. Use .env for actual keys)
# ==========================================

# AI Provider (Google Gemini API)
# Get your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY="your_gemini_api_key_here"
AI_MODEL=gemini-1.5-flash
AI_TIMEOUT_SECONDS=25

# Backend Security & JWT
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (MongoDB Atlas or Local MongoDB)
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB_NAME="skillarena"

# Cache & Rate Limiting (Redis Cloud or Local Redis)
REDIS_URL=redis://localhost:6379/0

# Rate Limiting & Safety Limits
RATE_LIMIT_PER_MINUTE=60
MAX_UPLOAD_SIZE_BYTES=10485760
MAX_QUESTIONS_PER_REQUEST=20

# App & Deployment
ENVIRONMENT=development
PORT=8000
