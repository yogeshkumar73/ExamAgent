# ==========================================
# SkillArena AI — Production .gitignore
# ==========================================

# Environment variables & sensitive credentials (Security)
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
*.pem
*.key
*.cert
*.pfx
secrets/
credentials.json

# ALLOW committed template
!.env.example

# Node & Frontend dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/
.npm/

# Build outputs
dist/
dist-ssr/
build/
out/
*.local

# Vercel deployment cache
.vercel/

# Python & ML Bytecode & Caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
.venv/
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# Type Checking
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/

# Database dumps & Redis caches
*.rdb
dump.rdb
mongodb_data/
redis_data/
data/db/
*.sqlite
*.sqlite3
*.db

# Vite & IDE Cache
.vite/
.idea/
.vscode/
*.sublime-workspace
*.sublime-project

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Temporary logs & scratch files
*.log
scratch/
tmp/
temp/
